# Fixture: OpenSSH client config, the subset Urfin imports (F03 §2.2).
Include config.d/*.conf
Include ~/.ssh/missing.conf

Host web-prod-01 web-prod-01.lab
    HostName 10.20.1.11
    User deploy
    Port 22
    IdentityFile ~/.ssh/deploy_ed25519
    ProxyJump bastion
    ServerAliveInterval 15
    ForwardAgent yes

Host bastion
    HostName=bastion.example.com
    User "jump user"
    Port 2222

Host *.internal !secret
    User nobody

Host *
    ServerAliveInterval 60

Match host db-*
    User dba

Host db-01
    HostName %h.db.example.com
    Port 5022

Host web-prod-01
    # First value wins, as in OpenSSH.
    User other
